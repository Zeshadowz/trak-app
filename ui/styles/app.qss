/*
 * app - Qt Style Sheet
 * Created: 5/7/26
 */

* root{
}

/* Base styling */
QWidget {
    background-color: #f0f0f0;
    color: #333333;
}

QLineEdit{
	border: 1px solid #CCC;
	border-radius: 4px;
	padding: 8px;
	font-size: 14px;
}
QLineEdit::focus{
	border-color: #007BFF
}

QProgressBar {
    border: 0px;
    border-radius: 5px;
    background-color: #e0e0e0;
    min-height: 12px;
    max-height: 12px;
    text-align: center;
}

QProgressBar::chunk {
    width: 12px;
    background: #05b8cc;
}

QPushButton {
	background-color: #007BFF;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 14px;
}
QPushButton:disabled {
	background-color: rgba(0, 0, 0, 0.12);
    color: rgba(0, 0, 0, 0.3);
}
QPushButton:hover {
	background-color: #0055FF;
}
QPushButton:pressed {
	border: 2px solid #0056b3;
}

/* Add your QSS styles here */
